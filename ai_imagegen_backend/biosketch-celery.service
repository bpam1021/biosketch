[Unit]
Description=Biosketch AI Platform Celery Services
After=network.target redis.service
Wants=redis.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
WorkingDirectory=/root/biosketch/ai_imagegen_backend
Environment=DJANGO_SETTINGS_MODULE=science_image_gen.settings
Environment=PATH=/root/biosketch/ai_imagegen_backend/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash /root/biosketch/ai_imagegen_backend/start_celery_systemd.sh
ExecStop=/bin/bash /root/biosketch/ai_imagegen_backend/stop_celery.sh
TimeoutStartSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target